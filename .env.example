# n8n Webhook URL — the endpoint that receives booking form submissions as JSON payloads
# Example: https://your-n8n-instance.com/webhook/booking
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/booking

# Resend API Key — used to send transactional booking confirmation and contact form emails
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public Business Name — displayed in the site header, footer, meta tags, and emails
# This is exposed to the client (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_BUSINESS_NAME=Your Auto Detailing Business

# Business Email — recipient address for contact form submissions (optional, defaults to noreply)
BUSINESS_EMAIL=info@yourbusiness.com
